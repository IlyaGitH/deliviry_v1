[Unit]
Description=ATSD | Защищённый журнал событий
Before=atsd-web.service

[Service]
User=root
UMask=0077
RuntimeDirectory=atsd-audit
RuntimeDirectoryMode=0755
ExecStart=/usr/bin/python3 -I /usr/local/libexec/atsd-audit.py
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/atsd-security /run/atsd-audit
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
