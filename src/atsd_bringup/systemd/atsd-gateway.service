[Unit]
Description=ATSD | HTTPS и взаимная аутентификация устройств
Requires=atsd-web.service
After=network.target atsd-web.service
PartOf=atsd.target

[Service]
Type=simple
RuntimeDirectory=atsd-gateway
RuntimeDirectoryMode=0755
ExecStartPre=/usr/sbin/nginx -t -c /etc/atsd/security/nginx.conf
ExecStart=/usr/sbin/nginx -c /etc/atsd/security/nginx.conf -g "daemon off;"
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=atsd.target
