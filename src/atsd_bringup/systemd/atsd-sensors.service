[Unit]
Description=ATSD | Лидар, камера, GNSS
After=network-online.target
PartOf=atsd.target

[Service]
Type=simple
User=atsd
Group=atsd
WorkingDirectory=/opt/atsd
Environment=HOME=/opt/atsd
Environment=ROS_DOMAIN_ID=17
Environment=GPIOZERO_PIN_FACTORY=lgpio
Environment=RCUTILS_LOGGING_BUFFERED_STREAM=1
Restart=always
TimeoutStopSec=15
KillSignal=SIGINT
SupplementaryGroups=dialout video
RestartSec=5
ExecStart=/opt/atsd/run.sh ros2 launch atsd_bringup sensors.launch.py

[Install]
WantedBy=atsd.target
